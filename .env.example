# ===============================================
# Variables de Entorno para Coolify (Parámetros Separados)
# ===============================================

PORT=3000
NODE_ENV=production
JWT_SECRET=tu_clave_secreta_institucional_super_segura_2026

# --- CONEXIÓN A POSTGRESQL (PARÁMETROS SEPARADOS) ---
DB_HOST=10.0.0.X_o_ip_del_servidor_postgres
DB_PORT=5432
DB_USER=nombre_usuario_postgres
DB_PASSWORD=tu_password_de_postgres
DB_NAME=nombre_de_la_base_de_datos

# Opcional si tu base requiere SSL (true o false)
DB_SSL=false

# --- ALMACENAMIENTO DE ARCHIVOS ---
DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads
MAX_FILE_SIZE_MB=50
