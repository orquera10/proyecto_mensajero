# Puerto del Servidor
PORT=3000

# Clave secreta para tokens JWT de autenticación
JWT_SECRET=institucional_jwt_secret_super_seguro_2026

# Tamaño máximo de adjuntos permitidos (en MB)
MAX_FILE_SIZE_MB=50

# Directorios de datos y archivos adjuntos (Mapear a volúmenes persistentes en Coolify)
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads

# 🐘 Conexión PostgreSQL (Recomendado para Coolify)
# Puedes usar la URL completa:
DATABASE_URL=postgresql://postgres:mypassword@postgres:5432/mensajero_db

# O variables individuales:
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=mypassword
# DB_NAME=mensajero_db
# DB_SSL=false
